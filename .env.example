# =============================================================================
# Resonate environment variables
# Copy this file to .env.local (for local dev) or .env (for production / Vercel CLI)
# and fill in the values.
# =============================================================================

# ---------- Database (Supabase or Neon Postgres) ----------
# Pooled connection string (used by the app at runtime) — has ?pgbouncer=true
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.abcdefgh.supabase.co:5432/postgres?pgbouncer=true"

# Direct connection string (used by Prisma for migrations) — NO ?pgbouncer=true
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.abcdefgh.supabase.co:5432/postgres"

# ---------- NextAuth ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="paste-output-of-openssl-rand-base64-32-here"

# Where the app is reachable. For local dev: http://localhost:3000
# For production: https://your-app.vercel.app (use the exact Vercel URL, no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ---------- Email (Resend) ----------
# Sign up at https://resend.com — free tier, 3000 emails/month
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# For testing on the free tier, use Resend's shared sender:
EMAIL_FROM="Resonate <onboarding@resend.dev>"
# For production, after verifying your domain at Resend:
# EMAIL_FROM="Resonate <no-reply@yourdomain.com>"

# ---------- Campus access control ----------
# Comma-separated list of allowed email domains.
# Only students with emails at these domains can sign up.
# Use "*" to allow any email (development only — DO NOT USE IN PRODUCTION)
ALLOWED_DOMAINS="yourcampus.edu,yourcampus.ac.in"
