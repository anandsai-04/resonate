// Resonate — Campus music player schema (PostgreSQL)
// Multi-user: every record is scoped to a User (campus student).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase / Neon use a pooled connection for the app (DATABASE_URL)
  // and a direct connection for migrations (DIRECT_URL).
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

// ---------------------------------------------------------------------------
// PRIMARY TABLE — Student identity
// ---------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  // Student-specific fields
  regdNumber    String?   @unique             // registration / roll number
  course        String?                       // e.g. "B.Tech Computer Science"
  university    String?                       // derived from email domain
  year          Int?                          // 1, 2, 3, 4
  role          Role      @default(STUDENT)
  emailVerified DateTime?
  joinedAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  preference    UserPreference?
  playlists     Playlist[]
  savedAlbums   SavedAlbum[]
  history       ListeningHistory[]
}

// ---------------------------------------------------------------------------
// SECONDARY TABLE — Music preferences (one row per user)
// ---------------------------------------------------------------------------
model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Preference arrays — native Postgres arrays, fast & indexed
  genres          String[] @default([])     // ["rock", "bollywood", "lo-fi"]
  languages       String[] @default([])     // ["hindi", "english", "punjabi"]
  artists         String[] @default([])     // ["Arijit Singh", "The Weeknd"]
  albums          String[] @default([])     // source album IDs the user loves
  moods           String[] @default([])     // ["romantic", "chill", "energetic"]

  // Algorithm tuning
  discoveryLevel  Float    @default(0.3)    // 0=safe, 1=wild exploration
  autoPlayNext    Boolean  @default(true)
  explicitFilter  Boolean  @default(false)

  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cached track metadata (shared across all users)
// ---------------------------------------------------------------------------
model Track {
  id         String   @id @default(cuid())
  // Unique ID from upstream source (iTunes trackId or JioSaavn songId)
  // Kept as `saavnId` for backward-compat with existing code.
  saavnId    String   @unique
  source     String   @default("itunes")   // "itunes" | "saavn"
  title      String
  artist     String
  album      String?
  albumId    String?
  duration   Int      @default(0)
  image      String?
  streamUrl  String?
  language   String?
  label      String?
  year       String?
  mood       String?
  tempo      String?
  genre      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  playlists  PlaylistTrack[]
  history    ListeningHistory[]
  savedBy    SavedAlbum[]

  @@index([saavnId])
  @@index([mood])
  @@index([artist])
}

model Playlist {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  mood        String?
  isPublic    Boolean  @default(false)   // shareable playlists
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model SavedAlbum {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  saavnId   String                              // source album ID
  title     String
  artist    String
  image     String?
  year      String?
  language  String?
  trackId   String?
  track     Track?   @relation(fields: [trackId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, saavnId])
  @@index([userId])
}

model ListeningHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playedAt  DateTime @default(now())
  completed Boolean  @default(false)
  skipped   Boolean  @default(false)

  @@index([userId, playedAt])
  @@index([trackId])
}
