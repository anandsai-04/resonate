const SAAVN_BASE = "https://saavn.dev/api"

export interface SaavnSong {
  id: string
  title: string
  artist: string
  album: string
  albumId?: string
  image: string
  streamUrl: string
  duration: number
  language?: string
  label?: string
  year?: string
  url?: string
}

export interface SaavnAlbum {
  id: string
  name: string
  artist: string
  image: string
  year?: string
  language?: string
  songCount?: number
  url?: string
  songs?: SaavnSong[]
}

export interface SaavnLyrics {
  syncLyrics?: string
  plainLyrics?: string
}

interface SaavnRawSong {
  id: string
  name: string
  primaryArtists?: string
  artists?: { primary?: { name: string }[] }
  album?: { name: string; id?: string; url?: string }
  image?: { quality: string; url: string }[]
  downloadUrl?: { quality: string; url: string }[]
  duration?: number
  language?: string
  label?: string
  year?: string
  url?: string
}

function pickBestImage(images?: { quality: string; url: string }[]): string {
  if (!images || images.length === 0) return ""
  const preferred = images.find((i) => i.quality.includes("500")) ?? images[images.length - 1]
  return preferred.url
}

function pickBestStream(urls?: { quality: string; url: string }[]): string {
  if (!urls || urls.length === 0) return ""
  const preferred = urls.find((u) => u.quality.includes("320")) ?? urls[urls.length - 1]
  return preferred.url
}

function decodeHtml(s: string): string {
  if (!s) return ""
  return s.replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#039;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">")
}

function normalizeSong(raw: SaavnRawSong): SaavnSong {
  const primaryArtist = raw.primaryArtists || (raw.artists?.primary?.map((a) => a.name).join(", ") ?? "Unknown Artist")
  return {
    id: raw.id,
    title: decodeHtml(raw.name),
    artist: decodeHtml(primaryArtist),
    album: raw.album?.name ? decodeHtml(raw.album.name) : "",
    albumId: raw.album?.id,
    image: pickBestImage(raw.image),
    streamUrl: pickBestStream(raw.downloadUrl),
    duration: raw.duration ?? 0,
    language: raw.language,
    label: raw.label,
    year: raw.year,
    url: raw.url,
  }
}

async function saavnFetch<T>(path: string): Promise<T> {
  const res = await fetch(`${SAAVN_BASE}${path}`, {
    headers: { "User-Agent": "Mozilla/5.0 (compatible; ResonatePlayer/1.0)", "Accept": "application/json" },
  })
  if (!res.ok) throw new Error(`Saavn API ${res.status}: ${res.statusText}`)
  return (await res.json()) as T
}

export async function searchSongs(query: string, limit = 20): Promise<SaavnSong[]> {
  if (!query.trim()) return []
  const data = await saavnFetch<{ success: boolean; data: { results: SaavnRawSong[] } }>(`/search/songs?query=${encodeURIComponent(query)}&limit=${limit}`)
  return (data.data?.results ?? []).map(normalizeSong)
}

export async function searchAlbums(query: string, limit = 10): Promise<SaavnAlbum[]> {
  if (!query.trim()) return []
  const data = await saavnFetch<{ success: boolean; data: { results: any[] } }>(`/search/albums?query=${encodeURIComponent(query)}&limit=${limit}`)
  return (data.data?.results ?? []).map((a) => ({
    id: a.id,
    name: decodeHtml(a.name),
    artist: decodeHtml(a.primaryArtists ?? a.artists?.primary?.map((x: any) => x.name).join(", ") ?? "Unknown"),
    image: pickBestImage(a.image),
    year: a.year,
    language: a.language,
    songCount: a.songCount,
    url: a.url,
  }))
}

export async function getSongDetails(songId: string): Promise<SaavnSong | null> {
  try {
    const data = await saavnFetch<{ success: boolean; data: SaavnRawSong }>(`/songs/${songId}`)
    return data.data ? normalizeSong(data.data) : null
  } catch { return null }
}

export async function getAlbumDetails(albumId: string): Promise<SaavnAlbum | null> {
  try {
    const data = await saavnFetch<{ success: boolean; data: any }>(`/albums?id=${albumId}`)
    const a = data.data
    if (!a) return null
    return {
      id: a.id,
      name: decodeHtml(a.name),
      artist: decodeHtml(a.primaryArtists ?? a.artists?.primary?.map((x: any) => x.name).join(", ") ?? "Unknown"),
      image: pickBestImage(a.image),
      year: a.year,
      language: a.language,
      songCount: a.songCount,
      url: a.url,
      songs: (a.songs ?? []).map(normalizeSong),
    }
  } catch { return null }
}

export async function getLyrics(songId: string): Promise<SaavnLyrics> {
  try {
    const data = await saavnFetch<{ success: boolean; data: { syncLyrics?: string; plainLyrics?: string } }>(`/songs/${songId}/lyrics`)
    return { syncLyrics: data.data?.syncLyrics, plainLyrics: data.data?.plainLyrics }
  } catch { return {} }
}
